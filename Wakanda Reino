local function findGround(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ex = {}
	if localPlayer.Character then
		table.insert(ex, localPlayer.Character)
	end
	local old = workspace:FindFirstChild("WakandaPortal")
	if old then
		table.insert(ex, old)
	end
	params.FilterDescendantsInstances = ex
	local r = workspace:Raycast(pos + Vector3.new(0, 40, 0), Vector3.new(0, -140, 0), params)
	return r and r.Position.Y or nil
end

local portalGroundY = PORTAL_POS.Y - 4

local function createPortalTerminal()
	local old = workspace:FindFirstChild("WakandaPortal")
	if old then
		old:Destroy()
	end
	local F = Instance.new("Folder")
	F.Name = "WakandaPortal"
	F.Parent = workspace

	local gy = findGround(PORTAL_POS) or (PORTAL_POS.Y - 4)
	local by = math.max(PORTAL_POS.Y, gy + 3.5) -- altura do botao (Y = 4 pedido)
	portalGroundY = gy
	local bp = Vector3.new(PORTAL_POS.X, by, PORTAL_POS.Z)
	local metal = Color3.fromRGB(34, 32, 48)

	-- base e pedestal
	sp(F, Vector3.new(1, 30, 30), CFrame.new(bp.X, gy + 0.5, bp.Z) * VERT, metal, Enum.Material.Metal,
