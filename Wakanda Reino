local function createCrystal(parent, pos, h)
	local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, PI), rng:NextNumber(-0.25, 0.25))
	make(parent, V(h * 0.22, h, h * 0.22), cf * CFrame.new(0, h / 2, 0), C.Vib, Enum.Material.Neon,
		{ Transparency = 0.15, CanCollide = false, Name = "CristalVibranium" })
	make(parent, V(h * 0.16, h * 0.16, h * 0.16), cf * CFrame.new(0, h + h * 0.04, 0) * CFrame.Angles(0.78, 0.78, 0),
		C.VibLight, Enum.Material.Neon, { CanCollide = false, Name = "PontaCristal" })
end

local function createVibraniumArea(parent, c)
	cyl(parent, 0.5, 150, c + V(0, 0.55, 0), C.DarkMetal, Enum.Material.Metal, { Name = "PlataformaVibranium" })
	cyl(parent, 0.1, 146, c + V(0, 0.83, 0), C.Vib, Enum.Material.Neon, { CanCollide = false, Name = "BordaVibranium" })
	cyl(parent, 0.14, 142, c + V(0, 0.85, 0), C.DarkMetal, Enum.Material.Metal, { Name = "PisoVibranium" })
	-- cristais centrais
	for i = 1, 5 do
		local a = i / 5 * 2 * PI
		createCrystal(parent, c + V(math.cos(a) * 7, 0.8, math.sin(a) * 7), rng:NextNumber(40, 60))
	end
	local core = ball(parent, V(6, 6, 6), c + V(0, 20, 0), C.VibLight, Enum.Material.Neon, { CanCollide = false, Name = "NucleoVibranium" })
	addLight(core, C.Vib, 70, 2.5)
	-- anel de cristais
	for i = 1, 10 do
		local a = i / 10 * 2 * PI + 0.2
		createCrystal(parent, c + V(math.cos(a) * 45, 0.8, math.sin(a) * 45), rng:NextNumber(18, 34))
	end
	-- minerios (rochas com veios)
	for i = 1, 8 do
		local a = i / 8 * 2 * PI
		local p = c + V(math.cos(a) * 62, 0, math.sin(a) * 62)
		ball(parent, V(10, 7, 10), p + V(0, 2.5, 0), Color3.fromRGB(52, 46, 66), Enum.Material.Slate, { Name = "Minerio" })
		make(parent, V(0.8, 6, 0.8), p + V(0, 5, 0), C.Vib, Enum.Material.Neon,
			{ CanCollide = false, Name = "VeioVibranium" })
	end
	-- plataformas tecnologicas
	for _, o in ipairs({ V(-30, 0, 28), V(30, 0, 28), V(0, 0, 38) }) do
		cyl(parent, 0.5, 18, c + o + V(0, 1.1, 0), C.Metal, Enum.Material.Metal, { Name = "PlataformaTec" })
		cyl(parent, 0.1, 18, c + o + V(0, 1.4, 0), C.Vib, Enum.Material.Neon, { CanCollide = false })
	end
	-- paredes tecnologicas
	for k = 0, 7 do
		local a = (k + 0.5) * PI / 4
		local p = c + V(math.cos(a) * 70, 0, math.sin(a) * 70)
		local cf = CFrame.lookAt(p, V(c.X, 0, c.Z))
		make(parent, V(28, 10, 2), cf * CFrame.new(0, 5.8, 0), C.DarkMetal, Enum.Material.Metal, { Name = "ParedeTec" })
		make(parent, V(28.2, 0.6, 2.2), cf * CFrame.new(0, 8, 0), C.Vib, Enum.Material.Neon, { CanCollide = false })
		make(parent, V(0.5, 8, 2.2), cf * CFrame.new(0, 5.8, 0), C.VibLight, Enum.Material.Neon, { CanCollide = false })
	end
	-- laboratorios
	createLab(parent, c + V(0, 0, -48), c, 40, 26, C.Vib)
	createLab(parent, c + V(-52, 0, -10), c, 26, 20, C.VibLight)
