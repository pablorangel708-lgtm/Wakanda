local function smooth(t)
	return t * t * (3 - 2 * t)
end

local function easeOut(t)
	return 1 - (1 - t) ^ 3
end

-- peca absoluta (coordenadas de mundo, sem escala nem offset)
local function sp(parent, size, cf, color, material, opts)
	opts = opts or {}
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = opts.CanQuery == true
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = opts.Transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Name = opts.Name or "Part"
	if opts.Shape then
		p.Shape = opts.Shape
	end
	p.Parent = parent
	return p
end

