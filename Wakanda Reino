------------------------------------------------------------------
-- LAYOUT DO MAPA (coordenadas relativas ao centro de Wakanda)
-- Norte = -Z : montanhas > campo de batalha > cidade > areas ao sul
------------------------------------------------------------------
local RING_R = 240
local BC = V(0, 0, -1500)      -- centro do campo de batalha
local TECH_C = V(-620, 0, 560) -- laboratorios (sudoeste)
local VIB_C = V(620, 0, 560)   -- vibranium (sudeste)
local PAN_C = V(0, 0, 1090)    -- area do Pantera Negra (sul)
local PAD_C = V(190, 0, 330)   -- porto de naves (destino da viagem)
local PAD_TOP = 1.7

local function ringPt(k)
	local a = k * PI / 8
	return V(math.cos(a) * RING_R, 0, math.sin(a) * RING_R)
end

local function createRoads(parent, lights)
	local ring = {}
	for k = 0, 15 do
		ring[k] = ringPt(k)
	end
	for k = 0, 15 do
		createRoad(parent, ring[k], ring[(k + 1) % 16], 30, { Lights = lights, Both = false, Spacing = 90 })
		cyl(parent, 0.4, 30, ring[k] + V(0, 0.3, 0), C.Road, Enum.Material.Asphalt, { Name = "JuntaAnel" })
	end
	-- avenidas principais
	createRoad(parent, V(0, 0, 155), V(0, 0, 900), 50, { Lights = lights, Trees = true, Spacing = 100 })
