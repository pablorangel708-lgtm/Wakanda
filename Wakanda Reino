local function createStele(parent, pos, w, h, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	make(parent, V(w + 2, 1, 3), cf * CFrame.new(0, 0.9, 0), C.Metal, Enum.Material.Metal, { Name = "BaseSteleo" })
	make(parent, V(w + 0.8, h + 0.8, 0.4), cf * CFrame.new(0, 1.4 + h / 2, 0), C.Vib, Enum.Material.Neon,
		{ CanCollide = false, Name = "MoldeNeon" })
	local panel = make(parent, V(w, h, 0.8), cf * CFrame.new(0, 1.4 + h / 2, 0), C.DarkMetal, Enum.Material.Metal,
		{ Name = "PainelMapa" })
	addMap(panel, Enum.NormalId.Front)
	addMap(panel, Enum.NormalId.Back)
end

local function createPlaza(parent, pos, size, pond)
	make(parent, V(size, 0.5, size), pos + V(0, 0.45, 0), Color3.fromRGB(172, 162, 148), Enum.Material.Slate,
		{ Name = "Praca" })
	local half = (size - 4) / 2
	make(parent, V(size - 4, 0.1, 0.6), pos + V(0, 0.72, half), C.Vib, Enum.Material.Neon, { CanCollide = false })
	make(parent, V(size - 4, 0.1, 0.6), pos + V(0, 0.72, -half), C.Vib, Enum.Material.Neon, { CanCollide = false })
	make(parent, V(0.6, 0.1, size - 4), pos + V(half, 0.72, 0), C.Vib, Enum.Material.Neon, { CanCollide = false })
	make(parent, V(0.6, 0.1, size - 4), pos + V(-half, 0.72, 0), C.Vib, Enum.Material.Neon, { CanCollide = false })
	if pond then
		createPond(parent, pos + V(0, 0, 0), 13)
		createBridge(parent, pos + V(-22, 0, 0), pos + V(22, 0, 0), 8, false)
	else
		createFountain(parent, pos + V(0, 0.5, 0), 1.1)
	end
	createStele(parent, pos + V(size / 2 - 6, 0.5, size / 2 - 6), 8, 10, PI)
	reserve(pos.X, pos.Z, size * 0.75)
end

