local function createPond(parent, pos, r)
	cyl(parent, 0.7, r * 2 + 6, pos + V(0, 0.55, 0), C.Stone, Enum.Material.Slate, { Name = "MargemLago" })
	cyl(parent, 0.4, r * 2, pos + V(0, 0.75, 0), C.Water, Enum.Material.SmoothPlastic,
		{ Transparency = 0.2, Reflectance = 0.2, CanCollide = false, Name = "Lago" })
	reserve(pos.X, pos.Z, r + 6)
end

local function createRiver(parent, pts, width)
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local mid, len = (a + b) / 2, (b - a).Magnitude
		local cf = CFrame.lookAt(mid, b)
		make(parent, V(width, 0.5, len), cf * CFrame.new(0, 0.35, 0), C.Water, Enum.Material.SmoothPlastic,
			{ Transparency = 0.2, Reflectance = 0.2, CanCollide = false, Name = "Rio" })
		for _, s in ipairs({ -1, 1 }) do
			make(parent, V(2.2, 0.9, len), cf * CFrame.new(s * (width / 2 + 1.1), 0.4, 0), C.Stone,
				Enum.Material.Slate, { Name = "MargemRio" })
		end
		riverSegs[#riverSegs + 1] = { ax = a.X, az = a.Z, bx = b.X, bz = b.Z, w = width }
	end
	for _, p in ipairs(pts) do
		cyl(parent, 0.5, width, p + V(0, 0.35, 0), C.Water, Enum.Material.SmoothPlastic,
			{ Transparency = 0.2, Reflectance = 0.2, CanCollide = false, Name = "RioCurva" })
	end
end

local function createWaterfall(parent, base, target, width, height)
	local flat = V(target.X, base.Y, target.Z)
	local cf = CFrame.lookAt(base, flat)
	local rock = Color3.fromRGB(88, 86, 82)
	-- paredao de pedra atras da queda
	make(parent, V(width + 30, height, 24), cf * CFrame.new(0, height / 2, 12), rock, Enum.Material.Rock,
		{ Name = "Paredao" })
	make(parent, V(width + 30, 4, 44), cf * CFrame.new(0, height + 2, 8), Color3.fromRGB(70, 104, 60),
		Enum.Material.Grass, { Name = "Topo" })
	make(parent, V(width, 0.5, 30), cf * CFrame.new(0, height + 4.25, 5), C.Water, Enum.Material.SmoothPlastic,
		{ Transparency = 0.2, CanCollide = false, Name = "Canal" })
	-- queda d'agua
	make(parent, V(width, height + 4, 3), cf * CFrame.new(0, (height + 4) / 2, -1.5), Color3.fromRGB(150, 215, 255),
		Enum.Material.SmoothPlastic, { Transparency = 0.3, Reflectance = 0.1, CanCollide = false, Name = "Queda" })
	for i = -1, 1 do
		make(parent, V(1.2, height * 0.6, 3.3), cf * CFrame.new(i * width * 0.28, height * 0.5, -1.6), C.Foam,
			Enum.Material.SmoothPlastic, { Transparency = 0.5, CanCollide = false, Name = "Espuma" })
	end
	make(parent, V(width + 4, 3, 4), cf * CFrame.new(0, 1.5, -3.5), C.Foam, Enum.Material.SmoothPlastic,
		{ Transparency = 0.3, CanCollide = false, Name = "EspumaBase" })
	-- piscina
	local poolCF = cf * CFrame.new(0, 0, -width * 0.9)
	local poolPos = poolCF.Position
	cyl(parent, 0.7, width * 2.6 + 6, poolPos + V(0, 0.55, 0), C.Stone, Enum.Material.Slate, { Name = "MargemPiscina" })
	cyl(parent, 0.4, width * 2.6, poolPos + V(0, 0.75, 0), C.Water, Enum.Material.SmoothPlastic,
		{ Transparency = 0.2, Reflectance = 0.2, CanCollide = false, Name = "Piscina" })
	reserve(poolPos.X, poolPos.Z, width * 1.3 + 10)
	reserve(base.X, base.Z, width + 25)
	-- nevoa leve
	if emitterCount < 4 then
		emitterCount = emitterCount + 1
		local anchor = make(parent, V(width, 1, 3), cf * CFrame.new(0, 1, -3), C.Foam, Enum.Material.SmoothPlastic,
			{ Transparency = 1, CanCollide = false, Name = "Nevoa" })
		local e = Instance.new("ParticleEmitter")
		e.Rate = 10
		e.Lifetime = NumberRange.new(1, 2)
		e.Speed = NumberRange.new(2, 5)
		e.Size = NumberSequence.new(3, 6)
		e.Transparency = NumberSequence.new(0.6, 1)
		e.Color = ColorSequence.new(C.Foam)
		e.SpreadAngle = Vector2.new(60, 60)
		e.Parent = anchor
	end
	return poolPos
end

