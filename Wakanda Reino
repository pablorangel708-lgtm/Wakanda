local function animate(dur, fn)
	local t = 0
	while t < dur do
		local dt = RunService.RenderStepped:Wait()
		t = math.min(t + dt, dur)
		fn(t / dur, dt)
	end
end

local function travel()
	if traveling then
		return
	end
	if not wakandaReady then
		say("Wakanda ainda esta sendo construida... aguarde alguns segundos.", 3.2)
		return
	end
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root and hum.Health > 0) then
		return
	end
	traveling = true
	if promptRef then
		promptRef.Enabled = false
	end
	ui.button.Visible = false

	local cam = workspace.CurrentCamera
	local oldFov = cam.FieldOfView
	local ship, ramp, clouds, follow
	local shipCF = CFrame.new()

	local ok, err = pcall(function()
		-- 1) transicao e criacao da nave perto do jogador
		fadeTo(0, 0.45)
		local pos0 = Vector3.new(PORTAL_POS.X + 38, portalGroundY + 5, PORTAL_POS.Z)
		local flat = Vector3.new(DEST.X - pos0.X, 0, DEST.Z - pos0.Z)
		local heading = flat.Unit
		shipCF = CFrame.lookAt(pos0, pos0 + heading)
		ship, ramp = buildShip(shipCF)
		cam.CameraType = Enum.CameraType.Scriptable
		cam.CFrame = CFrame.lookAt(pos0 + Vector3.new(-30, 22, -34), pos0)
		cam.FieldOfView = 70
		letterbox(true)
		hum.PlatformStand = true
		task.wait(0.15)
		fadeTo(1, 0.5)
		say("Iniciando viagem para Wakanda...", 2.4)

		-- 2) o jogador entra na nave
		local startCF = root.CFrame
		local seatCF = shipCF * SEAT_LOCAL
		animate(1.5, function(s)
			root.CFrame = startCF:Lerp(seatCF, smooth(s))
			root.AssemblyLinearVelocity = Vector3.zero
			cam.CFrame = CFrame.lookAt(pos0 + Vector3.new(-30, 22, -34), shipCF.Position)
		end)
		follow = RunService.Heartbeat:Connect(function()
			root.CFrame = shipCF * SEAT_LOCAL
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end)
		ramp.Transparency = 1
		say("Decolando...", 2.2)

		-- 3) decolagem suave
		local p1 = pos0 + Vector3.new(0, 95, 0) + heading * 70
		animate(3.4, function(s)
			local pos = pos0:Lerp(p1, smooth(s))
			shipCF = CFrame.lookAt(pos, pos + heading + Vector3.new(0, 0.18 * math.sin(s * PI), 0))
			ship:PivotTo(shipCF)
			cam.CFrame = CFrame.lookAt((shipCF * CFrame.new(-34 + 20 * s, 14 + 10 * s, 62)).Position, pos)
		end)

		-- 4) voo ate Wakanda
		local p2 = DEST + Vector3.new(0, 230, 0)
		local dist = (p2 - p1).Magnitude
		local dur = math.clamp(dist / 620, 6, 11)
		clouds = Instance.new("Folder")
		clouds.Name = "NuvensViagem"
		clouds.Parent = workspace
		local function pathPos(s)
			return p1:Lerp(p2, smooth(s)) + Vector3.new(0, 260 * math.sin(PI * s), 0)
		end
		for i = 1, 16 do
			local s = i / 17
			local c = pathPos(s)
			local side = (i % 2 == 0) and 1 or -1
			createCloud(clouds, c + Vector3.new(heading.Z * side * rng:NextNumber(110, 300), rng:NextNumber(-70, 70),
				-heading.X * side * rng:NextNumber(110, 300)))
		end
		local wind = sp(ship, Vector3.new(220, 120, 220), shipCF, C.Foam, Enum.Material.SmoothPlastic,
			{ Transparency = 1, Name = "Vento" })
		local we = Instance.new("ParticleEmitter")
		we.Shape = Enum.ParticleEmitterShape.Box
		we.Rate = 140
		we.Lifetime = NumberRange.new(0.6, 1)
		we.Speed = NumberRange.new(0, 0)
		we.Size = NumberSequence.new(2.5, 0)
		we.LightEmission = 1
		we.LockedToPart = false
		we.Transparency = NumberSequence.new(0.3, 1)
		we.Color = ColorSequence.new(C.VibLight, C.Cyan)
		we.Parent = wind
		say("A caminho de Wakanda...", 3)
		animate(dur, function(s)
			local pos = pathPos(s)
			local a, b = pathPos(math.max(s - 0.015, 0)), pathPos(math.min(s + 0.015, 1))
			local dh = Vector3.new(b.X - a.X, 0, b.Z - a.Z).Magnitude
			local slope = math.clamp((b.Y - a.Y) / math.max(dh, 1), -0.4, 0.4)
			local fwd = (heading + Vector3.new(0, slope, 0)).Unit
			shipCF = CFrame.lookAt(pos, pos + fwd) * CFrame.Angles(0, 0, math.sin(s * PI * 2) * 0.12)
			ship:PivotTo(shipCF)
			wind.CFrame = CFrame.new(pos)
			local sweep = -58 + 116 * smooth(s)
			cam.CFrame = CFrame.lookAt((shipCF * CFrame.new(sweep, 18, 78)).Position, pos)
			cam.FieldOfView = 70 + 32 * math.sin(PI * s)
		end)
		wind:Destroy()
		if clouds then
			clouds:Destroy()
			clouds = nil
		end

		-- 5) aproximacao e pouso
		say("Chegando em Wakanda...", 3)
		local p3 = DEST + Vector3.new(0, 16, 0)
		animate(3.8, function(s)
			local pos = p2:Lerp(p3, easeOut(s))
			shipCF = CFrame.lookAt(pos, pos + heading + Vector3.new(0, -0.3 * (1 - s), 0))
			ship:PivotTo(shipCF)
			cam.CFrame = CFrame.lookAt((shipCF * CFrame.new(-30, 22 + 8 * (1 - s), 70)).Position, pos)
			cam.FieldOfView = 70 + 8 * (1 - s)
		end)
		local landPos = DEST + Vector3.new(0, 5.2, 0)
		animate(1.6, function(s)
			local pos = p3:Lerp(landPos, smooth(s))
			shipCF = CFrame.lookAt(pos, pos + heading)
			ship:PivotTo(shipCF)
			cam.CFrame = CFrame.lookAt((shipCF * CFrame.new(-30, 20, 64)).Position, pos)
		end)
		ramp.Transparency = 0

		-- 6) o jogador desce da nave
		if follow then
			follow:Disconnect()
			follow = nil
		end
		local out = shipCF:PointToWorldSpace(Vector3.new(0, 0, 36))
		out = Vector3.new(out.X, DEST.Y + 3.4, out.Z)
		local outCF = CFrame.lookAt(out, Vector3.new(CENTER.X, out.Y, CENTER.Z))
		local fromCF = root.CFrame
		animate(1.6, function(s)
			root.CFrame = fromCF:Lerp(outCF, smooth(s))
			root.AssemblyLinearVelocity = Vector3.zero
		end)
		say("Bem-vindo a Wakanda!", 3)
	end)

	if not ok then
		warn("[Wakanda] erro na viagem: " .. tostring(err))
		if wakandaReady and root and root.Parent then
			root.CFrame = CFrame.new(DEST + Vector3.new(30, 4, 0))
		end
	end

	-- limpeza e devolucao do controle
	if follow then
		follow:Disconnect()
	end
	if clouds then
		clouds:Destroy()
	end
	letterbox(false)
	cam.CameraType = Enum.CameraType.Custom
	if hum and hum.Parent then
		cam.CameraSubject = hum
		hum.PlatformStand = false
	end
	TweenService:Create(cam, TweenInfo.new(0.8), { FieldOfView = oldFov }):Play()
	if ship then
		task.delay(10, function()
			if ship then
				ship:Destroy()
			end
		end)
	end
	task.wait(1)
	traveling = false
	if promptRef then
		promptRef.Enabled = true
	end
end

local function setupPortal()
	buildUI()
	local prompt, cd = createPortalTerminal()
	prompt.Triggered:Connect(function(who)
		if who == localPlayer then
			travel()
		end
	end)
	cd.MouseClick:Connect(function(who)
		if who == localPlayer then
			travel()
		end
	end)
	prompt.PromptShown:Connect(function()
		ui.button.Visible = not traveling
	end)
	prompt.PromptHidden:Connect(function()
		ui.button.Visible = false
	end)
	ui.button.Activated:Connect(travel)
end


