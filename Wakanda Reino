end

local function createWakanda()
	local old = workspace:FindFirstChild("Wakanda")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "Wakanda"
	root.Parent = workspace

	local F = {}
	for _, n in ipairs({ "Terreno", "Palacio", "Cidade", "Estradas", "Montanhas", "Vegetacao", "Agua",
		"Vibranium", "Tecnologia", "Pantera", "Iluminacao", "Campo" }) do
		F[n] = folder(root, n)
	end

	run("terreno", function()
		for gx = -1500, 1500, 1000 do
			for gz = -2400, 1600, 1000 do
				make(F.Terreno, V(1000, 2, 1000), V(gx, -1, gz), C.Ground, Enum.Material.Grass, { Name = "Terreno" })
			end
		end
		cyl(F.Terreno, 0.3, 1240, V(0, 0.15, 0), C.City, Enum.Material.Concrete, { Name = "BaseCidade" })
	end)

	run("estradas", function()
		createRoads(F.Estradas, F.Iluminacao)
	end)

	local waterfalls = {}
	run("agua", function()
		local function wf(base, target, w, h)
			waterfalls[#waterfalls + 1] = base
			return createWaterfall(F.Agua, base, target, w, h)
		end
		local nwPool = wf(V(-700, 0, -720), V(-520, 0, -520), 36, 115)
		wf(V(780, 0, -560), V(560, 0, -400), 32, 105)
		wf(V(980, 0, 260), V(760, 0, 150), 32, 105)
		createRiver(F.Agua, { nwPool, V(-770, 0, -300), V(-780, 0, -100), V(-780, 0, 100), V(-790, 0, 300) }, 26)
		createPond(F.Agua, V(-800, 0, 380), 40)
	end)

	run("palacio", function()
		withScale(1.6, nil, function()
			createPalace(F.Palacio)
		end)
	end)
	run("vibranium", function()
		withScale(1.8, VIB_C, function()
			createVibraniumArea(F.Vibranium, Vector3.zero)
		end)
	end)
	run("tecnologia", function()
		withScale(1.8, TECH_C, function()
			createTechnologyArea(F.Tecnologia, Vector3.zero)
		end)
	end)
	run("pantera", function()
		withScale(1.5, PAN_C, function()
			createPantherArea(F.Pantera, Vector3.zero)
		end)
	end)
	run("porto", function()
		createLandingPad(F.Cidade, PAD_C)
	end)

	run("pracas", function()
		createPlaza(F.Cidade, V(215, 0, 215), 56, false)
		createPlaza(F.Cidade, V(-215, 0, 215), 56, false)
		createPlaza(F.Cidade, V(215, 0, -215), 56, false)
		createPlaza(F.Cidade, V(-215, 0, -215), 56, true)
	end)
	run("comercio", function()
		createDistricts(F)
	end)
	run("cidade", function()
		createCity(F.Cidade)
	end)

	run("torres", function()
		local placed, tries = 0, 0
		while placed < 8 and tries < 80 do
			tries = tries + 1
			local a = rng:NextNumber(0, 2 * PI)
			local r = rng:NextNumber(260, 580)
			local x, z = math.cos(a) * r, math.sin(a) * r
			if not blocked(x, z, 14) then
				withScale(2, V(x, 0.3, z), function()
					createEnergyTower(F.Tecnologia, Vector3.zero, rng:NextNumber(35, 60), C.Cyan)
				end)
				placed = placed + 1
			end
		end
	end)

	run("colinas", function()
		local made, tries = 0, 0
		while made < 14 and tries < 120 do
			tries = tries + 1
			local a = rng:NextNumber(0, 2 * PI)
			local r = rng:NextNumber(640, 950)
			local x, z = math.cos(a) * r, math.sin(a) * r
			local rad = rng:NextNumber(35, 65)
			if z > -800 and not blocked(x, z, rad + 10) then
				createHill(F.Terreno, V(x, 0, z), rad, rng:NextNumber(8, 18))
				made = made + 1
			end
		end
	end)

	run("campo", function()
		createBattlefield(F)
	end)

	run("montanhas", function()
		local avoid = { TECH_C, VIB_C, PAN_C }
		for _, wfp in ipairs(waterfalls) do
			table.insert(avoid, wfp)
		end
		local function nearAvoid(pos, d)
			for _, p in ipairs(avoid) do
				if (Vector3.new(p.X, 0, p.Z) - pos).Magnitude < d then
					return true
				end
			end
			return false
		end
		-- anel externo de montanhas gigantes (o norte fica com o campo de batalha)
		for i = 0, 21 do
			local ang = i / 22 * 2 * PI + rng:NextNumber(-0.04, 0.04)
			local r = 1450 + rng:NextNumber(-40, 40)
			local pos = V(math.cos(ang) * r, 0, math.sin(ang) * r)
			if pos.Z > -600 then
				createMountain(F.Montanhas, pos, rng:NextNumber(380, 460), rng:NextNumber(300, 450), true)
			end
		end
		-- anel interno (passagem aberta ao norte para a estrada)
		for i = 0, 15 do
			local ang = i / 16 * 2 * PI + rng:NextNumber(-0.05, 0.05)
			local pos = V(math.cos(ang) * 1000, 0, math.sin(ang) * 1000)
			if pos.Z > -650 and not nearAvoid(pos, 300) then
				local w = rng:NextNumber(220, 300)
				createMountain(F.Montanhas, pos, w, rng:NextNumber(100, 200), false)
				innerMountains[#innerMountains + 1] = { pos = pos, w = w }
			end
		end
		createFieldMountains(F.Montanhas)
	end)

	run("vegetacao", function()
		createVegetation(F.Vegetacao)
	end)

	if CONFIG.ApplyLighting then
		run("iluminacao", applyLighting)
	end

	wakandaReady = true
	print(string.format("[Wakanda] pronta: %d partes, %d luzes.", partCount, lightCount + streetLightCount))

	if CONFIG.TeleportPlayer then
		local player = Players.LocalPlayer
		local char = player.Character or player.CharacterAdded:Wait()
		char:PivotTo(CFrame.new(DEST + V(30, 6, 0)))
	end
end

-- o terminal de viagem aparece imediatamente; Wakanda e construida em seguida
task.spawn(function()
	local ok, err = pcall(setupPortal)
	if not ok then
		warn("[Wakanda] erro no portal: " .. tostring(err))
	end
end)
task.spawn(createWakanda)
