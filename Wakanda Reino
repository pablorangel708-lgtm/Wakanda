local function createBuilding(parent, pos, w, d, h, style)
	local cf = CFrame.lookAt(pos, V(0, pos.Y, 0))
	local dark = BUILD_COLORS[rng:NextInteger(1, #BUILD_COLORS)]
	local accent = ACCENTS[rng:NextInteger(1, #ACCENTS)]
	local ph = math.max(14, h * 0.1)
	local h1, h2, h3 = h * 0.55, h * 0.3, h * 0.15
	-- podio
	make(parent, V(w * 1.35, ph, d * 1.35), cf * CFrame.new(0, ph / 2 + 0.3, 0), dark:Lerp(C.Stone, 0.35),
		Enum.Material.Concrete, { Shadow = true, Name = "Podio" })
	make(parent, V(w * 1.38, 1.2, d * 1.38), cf * CFrame.new(0, ph + 0.9, 0), accent, Enum.Material.Neon,
		{ CanCollide = false, Name = "BordaPodio" })
	-- torre em tres niveis
	make(parent, V(w, h1, d), cf * CFrame.new(0, ph + h1 / 2, 0), dark, Enum.Material.Metal,
		{ Shadow = true, Name = "Torre" })
	make(parent, V(w * 0.78, h2, d * 0.78), cf * CFrame.new(0, ph + h1 + h2 / 2, 0),
		dark:Lerp(Color3.new(1, 1, 1), 0.08), Enum.Material.Metal, { Name = "TorreMedia" })
	make(parent, V(w * 0.55, h3, d * 0.55), cf * CFrame.new(0, ph + h1 + h2 + h3 / 2, 0),
		dark:Lerp(Color3.new(1, 1, 1), 0.14), Enum.Material.Metal, { Name = "TorreTopo" })
	-- andares (faixas de neon)
	local floors = math.clamp(math.floor(h / 45), 2, 5)
	for i = 1, floors do
		make(parent, V(w + 0.6, 1.4, d + 0.6), cf * CFrame.new(0, ph + h1 * i / (floors + 1), 0), accent,
			Enum.Material.Neon, { CanCollide = false, Name = "Andar" })
	end
	make(parent, V(w * 0.6, h1 * 0.9, 0.8), cf * CFrame.new(0, ph + h1 * 0.5, -d / 2 - 0.3), C.Cyan,
		Enum.Material.Glass, { Transparency = 0.55, CanCollide = false, Name = "VidroFrontal" })
	for _, s in ipairs({ -1, 1 }) do
		make(parent, V(1.2, h1 * 0.95, 0.6), cf * CFrame.new(s * w * 0.42, ph + h1 * 0.5, -d / 2 - 0.3), accent,
			Enum.Material.Neon, { CanCollide = false, Name = "TiraVertical" })
	end
	local topY = ph + h
	if style == "spire" then
		cyl(parent, h * 0.2, 1.6, cf * CFrame.new(0, topY + h * 0.1, 0), C.Metal, Enum.Material.Metal,
			{ CanCollide = false, Name = "Antena" })
		ball(parent, V(4, 4, 4), cf * CFrame.new(0, topY + h * 0.2 + 2, 0), accent, Enum.Material.Neon,
			{ CanCollide = false, Name = "Farol" })
	elseif style == "dome" then
		ball(parent, V(w * 0.5, w * 0.35, d * 0.5), cf * CFrame.new(0, topY, 0), C.Gold, Enum.Material.Metal,
			{ Name = "Cupula" })
	else
		cyl(parent, 1, math.min(w, d) * 0.5, cf * CFrame.new(0, topY + 0.5, 0), accent, Enum.Material.Neon,
			{ CanCollide = false, Name = "AnelTopo" })
	end
end


