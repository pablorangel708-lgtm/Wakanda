local function createTree(parent, pos, scale, kind)
	scale = scale or 1
	kind = kind or rng:NextInteger(1, 3)
	local leaf = LEAVES[rng:NextInteger(1, #LEAVES)]
	local th = (9 + rng:NextNumber(0, 5)) * scale
	if kind == 1 then -- acacia (copa achatada)
		cyl(parent, th, 1.6 * scale, pos + V(0, th / 2, 0), C.Trunk, Enum.Material.Wood, { Name = "Tronco" })
		ball(parent, V(22, 6, 22) * scale, pos + V(0, th + 1, 0), leaf, Enum.Material.Grass,
			{ CanCollide = false, Name = "Copa" })
	elseif kind == 2 then -- arvore redonda
		cyl(parent, th * 0.8, 1.4 * scale, pos + V(0, th * 0.4, 0), C.Trunk, Enum.Material.Wood, { Name = "Tronco" })
		ball(parent, V(13, 13, 13) * scale, pos + V(0, th * 0.8 + 5 * scale, 0), leaf, Enum.Material.Grass,
			{ CanCollide = false, Name = "Copa" })
	else -- baobab
		cyl(parent, th * 0.9, 4 * scale, pos + V(0, th * 0.45, 0), Color3.fromRGB(120, 92, 70),
			Enum.Material.Wood, { Name = "Tronco" })
		ball(parent, V(18, 8, 18) * scale, pos + V(0, th * 0.9 + 2, 0), leaf, Enum.Material.Grass,
			{ CanCollide = false, Name = "Copa" })
	end
end

local function createBush(parent, pos, s)
	s = s or 1
	local leaf = LEAVES[rng:NextInteger(1, #LEAVES)]
	ball(parent, V(5 * s, 3 * s, 5 * s), pos + V(0, 1.2 * s, 0), leaf, Enum.Material.Grass,
		{ CanCollide = false, Name = "Arbusto" })
	if rng:NextNumber() < 0.4 then
		ball(parent, V(0.9, 0.9, 0.9), pos + V(rng:NextNumber(-1, 1), 2.6 * s, rng:NextNumber(-1, 1)),
			FLOWERS[rng:NextInteger(1, #FLOWERS)], Enum.Material.SmoothPlastic, { CanCollide = false, Name = "Flor" })
	end
end

local function createHill(parent, pos, r, h)
	local tiers = 3
	for i = 1, tiers do
		local th = h / tiers
		cyl(parent, th, r * 2 * (1 - (i - 1) * 0.28), pos + V(0, th * (i - 0.5), 0),
			i == tiers and C.Ground or C.GroundDark, Enum.Material.Grass, { Name = "Colina" })
	end
	hills[#hills + 1] = { pos = pos, r = r, h = h }
	reserve(pos.X, pos.Z, r + 4)
end

------------------------------------------------------------------
-- MONTANHAS
------------------------------------------------------------------
local function createMountain(parent, pos, width, height, snow)
	local tiers = 5
	local yaw = rng:NextNumber(0, PI)
	local base = ROCKS[rng:NextInteger(1, #ROCKS)]
	for i = 1, tiers do
		local f = (i - 1) / tiers
		local w = width * (1 - f * 0.82)
		local h = height / tiers
		local jx = rng:NextNumber(-1, 1) * width * 0.04 * i
		local jz = rng:NextNumber(-1, 1) * width * 0.04 * i
		local color, mat = base:Lerp(Color3.fromRGB(160, 156, 150), f * 0.6), Enum.Material.Rock
		if i == 1 then
			color, mat = Color3.fromRGB(62, 96, 56), Enum.Material.Grass
		elseif i == 2 then
			color, mat = Color3.fromRGB(78, 88, 62), Enum.Material.Ground
		elseif snow and i == tiers then
			color, mat = C.Snow, Enum.Material.Snow
		end
		local rel = CFrame.new(pos + V(jx, h * (i - 0.5), jz))
			* CFrame.Angles(rng:NextNumber(-0.05, 0.05), yaw + i * 0.5, rng:NextNumber(-0.05, 0.05))
		make(parent, V(w, h + 2, w * rng:NextNumber(0.8, 1.1)), rel, color, mat, { Name = "Montanha" })
	end
end

