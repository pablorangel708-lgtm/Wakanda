local function createLab(parent, pos, face, w, d, accent, title)
	local cf = CFrame.lookAt(pos, V(face.X, pos.Y, face.Z))
	local _, yaw = cf:ToEulerAnglesYXZ()
	local metal = C.DarkMetal
	local G, F = 14, 12 -- altura do terreo e de cada andar
	local y0 = 1.5 -- topo da plataforma

	-- plataforma de acesso
	make(parent, V(w + 40, 1.2, d + 44), cf * CFrame.new(0, 0.9, -8), C.Metal, Enum.Material.Metal,
		{ Name = "PlataformaLab" })
	make(parent, V(w + 40.4, 0.3, d + 44.4), cf * CFrame.new(0, 1.5, -8), accent, Enum.Material.Neon,
		{ CanCollide = false, Name = "BordaPlataforma" })

	-- terreo oco (entrada, grande corredor e sala de pesquisa)
	make(parent, V(w, G, 2), cf * CFrame.new(0, y0 + G / 2, d / 2 - 1), metal, Enum.Material.Metal,
		{ Shadow = true, Name = "ParedeFundoLab" })
	for _, s in ipairs({ -1, 1 }) do
		make(parent, V(2, G, d), cf * CFrame.new(s * (w / 2 - 1), y0 + G / 2, 0), metal, Enum.Material.Metal,
			{ Shadow = true, Name = "ParedeLab" })
		make(parent, V((w - 10) / 2, G, 2), cf * CFrame.new(s * ((w - 10) / 4 + 5), y0 + G / 2, -d / 2 + 1), metal,
			Enum.Material.Metal, { Shadow = true, Name = "FrenteLab" })
		make(parent, V(0.6, G - 2, 0.6), cf * CFrame.new(s * 5.3, y0 + G / 2, -d / 2 - 0.2), accent,
			Enum.Material.Neon, { CanCollide = false, Name = "BatenteNeon" })
	end
	make(parent, V(w, 2, d), cf * CFrame.new(0, y0 + G + 1, 0), metal, Enum.Material.Metal,
		{ Shadow = true, Name = "TetoTerreo" })
	make(parent, V(w - 4, 0.3, d - 4), cf * CFrame.new(0, y0 + 0.15, 0), Color3.fromRGB(40, 42, 58),
		Enum.Material.Metal, { Name = "PisoLab" })
	make(parent, V(2.4, 0.1, d - 8), cf * CFrame.new(0, y0 + 0.35, 0), accent, Enum.Material.Neon,
		{ CanCollide = false, Name = "CorredorNeon" })
	cyl(parent, 1.2, 12, cf * CFrame.new(0, y0 + 0.9, 4), C.Metal, Enum.Material.Metal, { Name = "MesaHolo" })
	ball(parent, V(5, 5, 5), cf * CFrame.new(0, y0 + 5, 4), accent, Enum.Material.Neon,
		{ Transparency = 0.35, CanCollide = false, Name = "HologramaLab" })
	for _, s in ipairs({ -1, 1 }) do
		createComputer(parent, (cf * CFrame.new(s * (w / 2 - 8), y0 + 0.3, d / 2 - 5)).Position, yaw, accent)
	end

	-- andares superiores
	local top = y0 + G + 2
	for i = 1, 3 do
		local inset = i * 0.05
		local ww, dd = w * (1 - inset), d * (1 - inset)
		make(parent, V(ww, F, dd), cf * CFrame.new(0, top + F * (i - 0.5), 0), metal:Lerp(C.Metal, i / 6),
			Enum.Material.Metal, { Shadow = true, Name = "AndarLab" })
		make(parent, V(ww + 0.8, 0.8, dd + 0.8), cf * CFrame.new(0, top + F * i, 0), accent, Enum.Material.Neon,
			{ CanCollide = false, Name = "LinhaAndar" })
		make(parent, V(ww * 0.84, F * 0.5, 0.6), cf * CFrame.new(0, top + F * (i - 0.5), -dd / 2 - 0.2), C.Cyan,
			Enum.Material.Glass, { Transparency = 0.45, CanCollide = false, Name = "SalaPesquisa" })
	end
	local roofY = top + F * 3

	-- cupula de pesquisa
	ball(parent, V(d * 0.7, d * 0.4, d * 0.7), cf * CFrame.new(0, roofY + 1, 0), C.Metal, Enum.Material.Metal,
		{ Reflectance = 0.15, Name = "CupulaPesquisa" })
	cyl(parent, 1.2, d * 0.72, cf * CFrame.new(0, roofY + 0.8, 0), accent, Enum.Material.Neon,
		{ CanCollide = false, Name = "AnelCupula" })

	-- placa de entrada
	local plaque = make(parent, V(w * 0.5, 4, 1.2), cf * CFrame.new(0, y0 + G + 1, -d / 2 - 0.8), C.Black,
		Enum.Material.Metal, { Name = "PlacaLab" })
	addLabel(plaque, Enum.NormalId.Front, title or "LABORATORIO DE WAKANDA", C.Gold)

	-- alas laterais, corredores suspensos, torres e energia
	local gap = 16
	for _, s in ipairs({ -1, 1 }) do
		local ww, dd, hh = w * 0.5, d * 0.72, 30
		local wx = s * (w / 2 + gap + ww / 2)
		make(parent, V(ww, hh, dd), cf * CFrame.new(wx, y0 + hh / 2, d * 0.1), metal, Enum.Material.Metal,
			{ Shadow = true, Name = "AlaLab" })
		make(parent, V(ww + 0.8, 0.8, dd + 0.8), cf * CFrame.new(wx, y0 + hh, d * 0.1), accent, Enum.Material.Neon,
			{ CanCollide = false, Name = "BordaAla" })
		make(parent, V(ww * 0.8, 9, 0.6), cf * CFrame.new(wx, y0 + hh * 0.55, d * 0.1 - dd / 2 - 0.2), C.Cyan,
			Enum.Material.Glass, { Transparency = 0.45, CanCollide = false, Name = "SalaAla" })
		make(parent, V(gap + 4, 7, 7), cf * CFrame.new(s * (w / 2 + gap / 2), y0 + 20, d * 0.1), C.Cyan,
			Enum.Material.Glass, { Shape = Enum.PartType.Cylinder, Transparency = 0.4, CanCollide = false, Name = "CorredorSuspenso" })
		ball(parent, V(ww * 0.8, ww * 0.5, ww * 0.8), cf * CFrame.new(wx, y0 + hh + 2, d * 0.1), C.Metal,
			Enum.Material.Metal, { Name = "CupulaAla" })
		cyl(parent, 46, 3, cf * CFrame.new(s * (w * 0.3), roofY + 23, d * 0.2), C.Metal, Enum.Material.Metal,
			{ Name = "TorreCom" })
		cyl(parent, 1, 4.4, cf * CFrame.new(s * (w * 0.3), roofY + 40, d * 0.2), accent, Enum.Material.Neon,
			{ CanCollide = false, Name = "AnelTorre" })
		ball(parent, V(4, 4, 4), cf * CFrame.new(s * (w * 0.3), roofY + 47, d * 0.2), accent, Enum.Material.Neon,
			{ CanCollide = false, Name = "LuzTorre" })
		cyl(parent, 38, 4, cf * CFrame.new(s * (w / 2 + 6), y0 + 19, -d / 2 - 4), C.Gold, Enum.Material.Metal,
			{ Name = "PilarFrontalLab" })
		cyl(parent, 1.2, 5, cf * CFrame.new(s * (w / 2 + 6), y0 + 38.6, -d / 2 - 4), accent, Enum.Material.Neon,
			{ CanCollide = false, Name = "AnelPilar" })
		createEnergyTower(parent, (cf * CFrame.new(s * (w / 2 + 34), y0, -d / 2 - 22)).Position, 46, accent)
		createHoloPanel(parent, (cf * CFrame.new(s * 22, y0, -d / 2 - 14)).Position, yaw, 14, 9, true, accent)
	end
	reserve(pos.X, pos.Z, math.max(w, d) * 0.9)
end

