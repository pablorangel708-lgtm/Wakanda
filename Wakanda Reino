-- UTILIDADES BASICAS
------------------------------------------------------------------
-- escala/deslocamento temporario para construir areas maiores reutilizando as mesmas funcoes
local curScale = 1
local curOff = Vector3.zero

local function applyScale(size, rel)
	if curScale == 1 and curOff == Vector3.zero then
		return size, rel
	end
	if typeof(rel) == "Vector3" then
		rel = rel * curScale + curOff
	else
		rel = CFrame.new(rel.Position * curScale + curOff) * rel.Rotation
	end
	return size * curScale, rel
end

local function withScale(s, off, fn)
	local ps, po = curScale, curOff
	curScale, curOff = s, off or Vector3.zero
	local ok, err = pcall(fn)
	curScale, curOff = ps, po
	if not ok then
		warn("[Wakanda] erro: " .. tostring(err))
	end
end

local function toCF(rel)
	if typeof(rel) == "Vector3" then
		return CFrame.new(CENTER + rel)
	end
	return CFrame.new(CENTER) * rel
end

local function toLocalCF(rel)
	if typeof(rel) == "Vector3" then
		return CFrame.new(rel)
	end
	return rel
end

local function throttle()
	partCount = partCount + 1
	if partCount % CONFIG.BatchSize == 0 then
		task.wait()
	end
end

local function withShape(opts, shape)
	local o = {}
	if opts then
		for k, v in pairs(opts) do
			o[k] = v
		end
	end
	o.Shape = shape
	return o
end

local function make(parent, size, rel, color, material, opts)
	opts = opts or {}
	size, rel = applyScale(size, rel)
	local p = Instance.new(opts.Class or "Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = toCF(rel)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Transparency = opts.Transparency or 0
	p.Reflectance = opts.Reflectance or 0
	p.CanCollide = opts.CanCollide ~= false
	p.CastShadow = opts.Shadow == true
	p.Name = opts.Name or "Part"
	if opts.Shape then
		p.Shape = opts.Shape
	end
	p.Parent = parent
	throttle()
	return p
end

-- cilindro vertical (altura, diametro)
local function cyl(parent, height, diameter, rel, color, material, opts)
	return make(parent, Vector3.new(height, diameter, diameter),
		toLocalCF(rel) * CFrame.Angles(0, 0, PI / 2), color, material,
		withShape(opts, Enum.PartType.Cylinder))
end

local function ball(parent, size, rel, color, material, opts)
	return make(parent, size, rel, color, material, withShape(opts, Enum.PartType.Ball))
end

local function wedge(parent, size, rel, color, material, opts)
	local o = withShape(opts, nil)
	o.Class = "WedgePart"
	return make(parent, size, rel, color, material, o)
end

local function folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function addLight(part, color, range, brightness, bypass)
	if not bypass then
		if lightCount >= CONFIG.MaxLights then
			return
		end
		lightCount = lightCount + 1
	end
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = part
end

local function addMap(part, face, tint)
	local d = Instance.new("Decal")
	d.Texture = MAP_TEXTURE
	d.Face = face
	if tint then
