------------------------------------------------------------------
-- REGISTROS ESPACIAIS (evita sobreposicao)
------------------------------------------------------------------
local roadSegs, riverSegs, circles = {}, {}, {}
local hills, innerMountains = {}, {}

local function distSeg(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	local t = 0
	if l2 > 0 then
		t = math.clamp(((px - ax) * dx + (pz - az) * dz) / l2, 0, 1)
	end
	local cx, cz = ax + t * dx, az + t * dz
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end

local function reserve(x, z, r)
	circles[#circles + 1] = { x = x * curScale + curOff.X, z = z * curScale + curOff.Z, r = r * curScale }
end

local function blocked(x, z, pad, allowRiver)
	for _, s in ipairs(roadSegs) do
		if distSeg(x, z, s.ax, s.az, s.bx, s.bz) < s.w / 2 + pad + 4 then
			return true
		end
	end
	if not allowRiver then
		for _, s in ipairs(riverSegs) do
			if distSeg(x, z, s.ax, s.az, s.bx, s.bz) < s.w / 2 + pad + 6 then
				return true
			end
		end
	end
	for _, c in ipairs(circles) do
		if math.sqrt((x - c.x) ^ 2 + (z - c.z) ^ 2) < c.r + pad then
			return true
		end
	end
	return false
end

local function groundY(x, z)
	if math.sqrt(x * x + z * z) < 600 then
		return 0.3
	end
	return 0
end

