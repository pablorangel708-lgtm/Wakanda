local function run(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[Wakanda] erro em " .. name .. ": " .. tostring(err))
	end
	task.wait()
end

local function createWakanda()
	local old = workspace:FindFirstChild("Wakanda")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "Wakanda"
	root.Parent = workspace

	local F = {}
	for _, n in ipairs({ "Terreno", "Palacio", "Cidade", "Estradas", "Montanhas", "Vegetacao", "Agua",
		"Vibranium", "Tecnologia", "Pantera", "Iluminacao" }) do
		F[n] = folder(root, n)
	end

	local VIB_C = V(270, 0, 250)
	local PAN_C = V(260, 0, -230)
	local TEC_C = V(-150, 0, -340)

	run("terreno", function()
		make(F.Terreno, V(2000, 2, 2000), V(0, -1, 0), C.Ground, Enum.Material.Grass, { Name = "Terreno" })
		cyl(F.Terreno, 0.3, 840, V(0, 0.15, 0), C.City, Enum.Material.Concrete, { Name = "BaseCidade" })
	end)

	run("estradas", function()
		createRoads(F.Estradas, F.Iluminacao)
	end)

	local waterfalls = {}
	run("agua", function()
		local nPool = createWaterfall(F.Agua, V(0, 0, -520), V(0, 0, -300), 44, 130)
		waterfalls[#waterfalls + 1] = V(0, 0, -520)
		createPond(F.Agua, nPool, 40)
		local nwBase = V(-440, 0, -470)
		local nwPool = createWaterfall(F.Agua, nwBase, V(-300, 0, -250), 34, 110)
		waterfalls[#waterfalls + 1] = nwBase
		createRiver(F.Agua, {
			nwPool, V(-300, 0, -250), V(-300, 0, 40), V(-260, 0, 220), V(-120, 0, 330),
		}, 26)
		createPond(F.Agua, V(-120, 0, 330), 40)
		waterfalls[#waterfalls + 1] = V(440, 0, -390)
		createWaterfall(F.Agua, V(440, 0, -390), V(200, 0, -100), 30, 100)
		waterfalls[#waterfalls + 1] = V(520, 0, 330)
		createWaterfall(F.Agua, V(520, 0, 330), V(250, 0, 150), 30, 100)
	end)

	run("palacio", function()
		createPalace(F.Palacio)
	end)
	run("vibranium", function()
		createVibraniumArea(F.Vibranium, VIB_C)
	end)
	run("tecnologia", function()
		createTechnologyArea(F.Tecnologia, TEC_C)
	end)
	run("pantera", function()
		createPantherArea(F.Pantera, PAN_C)
	end)

	run("pracas", function()
		createPlaza(F.Cidade, V(100, 0, 100), 56, false)
		createPlaza(F.Cidade, V(-100, 0, 100), 56, false)
		createPlaza(F.Cidade, V(100, 0, -100), 56, false)
		createPlaza(F.Cidade, V(-100, 0, -100), 56, true)
	end)

	run("comercio", function()
		for _, p in ipairs({ V(270, 0, 90), V(-215, 0, -100), V(150, 0, 300) }) do
			if not blocked(p.X, p.Z, 28) then
				createMall(F.Cidade, V(p.X, 0.3, p.Z))
			end
		end
		for _, p in ipairs({ V(-120, 0, 260), V(300, 0, -60), V(-250, 0, 120) }) do
			if not blocked(p.X, p.Z, 26) then
				createMarket(F.Cidade, V(p.X, 0, p.Z))
			end
		end
	end)

	run("cidade", function()
		createCity(F.Cidade)
	end)

	run("torres", function()
		local placed = 0
		local tries = 0
		while placed < 6 and tries < 60 do
			tries = tries + 1
			local a = rng:NextNumber(0, 2 * PI)
			local r = rng:NextNumber(220, 390)
			local x, z = math.cos(a) * r, math.sin(a) * r
			if not blocked(x, z, 12) then
				createEnergyTower(F.Tecnologia, V(x, 0.3, z), rng:NextNumber(45, 70), C.Cyan)
				placed = placed + 1
			end
		end
	end)

	run("colinas", function()
		local made, tries = 0, 0
		while made < 12 and tries < 80 do
			tries = tries + 1
			local a = rng:NextNumber(0, 2 * PI)
			local r = rng:NextNumber(440, 540)
			local x, z = math.cos(a) * r, math.sin(a) * r
			local rad = rng:NextNumber(35, 65)
			if not blocked(x, z, rad + 10) then
				createHill(F.Terreno, V(x, 0, z), rad, rng:NextNumber(8, 18))
				made = made + 1
			end
		end
	end)

	run("montanhas", function()
		for i = 0, 17 do
			local ang = i / 18 * 2 * PI + rng:NextNumber(-0.08, 0.08)
			local r = 800 + rng:NextNumber(-40, 40)
			local pos = V(math.cos(ang) * r, 0, math.sin(ang) * r)
			local w = rng:NextNumber(300, 380)
			local h = rng:NextNumber(230, 340)
			createMountain(F.Montanhas, pos, w, h, true)
			local rad = pos.Unit
			local tan = V(-rad.Z, 0, rad.X)
			createMountain(F.Montanhas, pos - rad * w * 0.35 + tan * w * 0.3, w * 0.6, h * 0.65, true)
		end
		for i = 0, 13 do
			local ang = i / 14 * 2 * PI + rng:NextNumber(-0.06, 0.06)
			local pos = V(math.cos(ang) * 640, 0, math.sin(ang) * 640)
			local near = false
			for _, wf in ipairs(waterfalls) do
				if (wf - pos).Magnitude < 190 then
					near = true
				end
			end
			if not near then
				local w = rng:NextNumber(170, 230)
				createMountain(F.Montanhas, pos, w, rng:NextNumber(90, 190), false)
				innerMountains[#innerMountains + 1] = { pos = pos, w = w }
			end
		end
	end)

	run("vegetacao", function()
		createVegetation(F.Vegetacao)
	end)

	if CONFIG.ApplyLighting then
		run("iluminacao", applyLighting)
	end

	if CONFIG.TeleportPlayer then
		local player = Players.LocalPlayer
		local char = player.Character or player.CharacterAdded:Wait()
		char:PivotTo(CFrame.new(CENTER + V(0, 8, 130)))
	end

	print(string.format("[Wakanda] pronta: %d partes, %d luzes.", partCount, lightCount + streetLightCount))
end

task.spawn(createWakanda)
