------------------------------------------------------------------
-- UTILIDADES BASICAS
------------------------------------------------------------------
local function toCF(rel)
	if typeof(rel) == "Vector3" then
		return CFrame.new(CENTER + rel)
	end
	return CFrame.new(CENTER) * rel
end

local function toLocalCF(rel)
	if typeof(rel) == "Vector3" then
		return CFrame.new(rel)
	end
	return rel
end

local function throttle()
	partCount = partCount + 1
	if partCount % CONFIG.BatchSize == 0 then
		task.wait()
	end
end

local function withShape(opts, shape)
	local o = {}
	if opts then
		for k, v in pairs(opts) do
			o[k] = v
		end
	end
	o.Shape = shape
	return o
end

local function make(parent, size, rel, color, material, opts)
	opts = opts or {}
	local p = Instance.new(opts.Class or "Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = toCF(rel)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Transparency = opts.Transparency or 0
	p.Reflectance = opts.Reflectance or 0
	p.CanCollide = opts.CanCollide ~= false
	p.CastShadow = opts.Shadow == true
	p.Name = opts.Name or "Part"
	if opts.Shape then
		p.Shape = opts.Shape
	end
	p.Parent = parent
	throttle()
	return p
end

-- cilindro vertical (altura, diametro)
local function cyl(parent, height, diameter, rel, color, material, opts)
	return make(parent, Vector3.new(height, diameter, diameter),
		toLocalCF(rel) * CFrame.Angles(0, 0, PI / 2), color, material,
		withShape(opts, Enum.PartType.Cylinder))
end

local function ball(parent, size, rel, color, material, opts)
	return make(parent, size, rel, color, material, withShape(opts, Enum.PartType.Ball))
end

local function wedge(parent, size, rel, color, material, opts)
	local o = withShape(opts, nil)
	o.Class = "WedgePart"
	return make(parent, size, rel, color, material, o)
end

local function folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function addLight(part, color, range, brightness, bypass)
	if not bypass then
		if lightCount >= CONFIG.MaxLights then
			return
		end
		lightCount = lightCount + 1
	end
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = part
end

local function addMap(part, face, tint)
	local d = Instance.new("Decal")
	d.Texture = MAP_TEXTURE
	d.Face = face
	if tint then
		d.Color3 = tint
	end
	d.Parent = part
	return d
end

local function addLabel(part, face, text, color)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 24
	g.Parent = part
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.TextColor3 = color or C.Gold
	t.Parent = g
end

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

------------------------------------------------------------------
-- REGISTROS ESPACIAIS (evita sobreposicao)
------------------------------------------------------------------
local roadSegs, riverSegs, circles = {}, {}, {}
local hills, innerMountains = {}, {}

local function distSeg(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	local t = 0
	if l2 > 0 then
		t = math.clamp(((px - ax) * dx + (pz - az) * dz) / l2, 0, 1)
	end
	local cx, cz = ax + t * dx, az + t * dz
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end

local function reserve(x, z, r)
	circles[#circles + 1] = { x = x, z = z, r = r }
end

local function blocked(x, z, pad, allowRiver)
	for _, s in ipairs(roadSegs) do
		if distSeg(x, z, s.ax, s.az, s.bx, s.bz) < s.w / 2 + pad + 4 then
			return true
		end
	end
	if not allowRiver then
		for _, s in ipairs(riverSegs) do
			if distSeg(x, z, s.ax, s.az, s.bx, s.bz) < s.w / 2 + pad + 6 then
				return true
			end
		end
	end
	for _, c in ipairs(circles) do
		if math.sqrt((x - c.x) ^ 2 + (z - c.z) ^ 2) < c.r + pad then
			return true
		end
	end
	return false
end

local function groundY(x, z)
	if math.sqrt(x * x + z * z) < 415 then
		return 0.3
	end
	return 0
end

