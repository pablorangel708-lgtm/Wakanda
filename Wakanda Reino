local function createCity(parent)
	local bands = {
		{ r = 125, hMin = 70, hMax = 120, kind = "sky" },
		{ r = 160, hMin = 50, hMax = 95, kind = "sky" },
		{ r = 225, hMin = 28, hMax = 62, kind = "mid" },
		{ r = 262, hMin = 24, hMax = 50, kind = "mid" },
		{ r = 298, hMin = 18, hMax = 40, kind = "mid" },
		{ r = 335, hMin = 12, hMax = 28, kind = "house" },
		{ r = 370, hMin = 10, hMax = 22, kind = "house" },
	}
	local styles = { "spire", "dome", "plain" }
	for bi, band in ipairs(bands) do
		local n = math.floor(2 * PI * band.r / 48)
		for i = 0, n - 1 do
			local ang = (i / n) * 2 * PI + bi * 0.2 + rng:NextNumber(-0.03, 0.03)
			local x = math.cos(ang) * band.r + rng:NextNumber(-4, 4)
			local z = math.sin(ang) * band.r + rng:NextNumber(-4, 4)
			if math.abs(x) >= 42 and math.abs(z) >= 42 and not blocked(x, z, 18) then
				local pos = V(x, 0.3, z)
				local roll = rng:NextNumber()
				if band.kind == "sky" then
					createBuilding(parent, pos, rng:NextNumber(20, 30), rng:NextNumber(20, 30),
						rng:NextNumber(band.hMin, band.hMax), styles[rng:NextInteger(1, 3)])
				elseif band.kind == "mid" then
					if roll < 0.45 then
						createHouse(parent, pos, rng:NextNumber(10, 14))
					else
						createBuilding(parent, pos, rng:NextNumber(14, 22), rng:NextNumber(14, 22),
							rng:NextNumber(band.hMin, band.hMax), "plain")
					end
				else
					if roll < 0.8 then
						createHouse(parent, pos, rng:NextNumber(10, 14))
					else
						createBuilding(parent, pos, rng:NextNumber(12, 16), rng:NextNumber(12, 16),
							rng:NextNumber(band.hMin, band.hMax), "plain")
					end
				end
				reserve(x, z, 14)
			end
		end
	end
end

------------------------------------------------------------------
-- VEGETACAO (distribuicao)
------------------------------------------------------------------
local function createVegetation(parent)
	-- jardim do palacio
	for k = 0, 29 do
		local a = k / 30 * 2 * PI
		local x, z = math.cos(a) * 112, math.sin(a) * 112
		if math.abs(x) > 34 and math.abs(z) > 34 and not blocked(x, z, 4) then
			if k % 2 == 0 then
				createTree(parent, V(x, 0.3, z), 0.9)
			else
				createBush(parent, V(x, 0.3, z), 1.2)
			end
		end
	end
	-- arvores nas avenidas
	for _, s in ipairs(roadSegs) do
		if s.trees then
			local dx, dz = s.bx - s.ax, s.bz - s.az
			local len = math.sqrt(dx * dx + dz * dz)
			local ux, uz = dx / len, dz / len
			local px, pz = -uz, ux
			local steps = math.floor(len / 40)
			for i = 1, steps do
				for _, side in ipairs({ -1, 1 }) do
					local off = s.width / 2 + 13
					local x = s.ax + ux * i * 40 + px * off * side
					local z = s.az + uz * i * 40 + pz * off * side
					if not blocked(x, z, 4) then
						createTree(parent, V(x, groundY(x, z), z), 0.85)
					end
				end
			end
		end
	end
	-- margens do rio
	for i = 1, #riverSegs do
		local s = riverSegs[i]
		local dx, dz = s.bx - s.ax, s.bz - s.az
		local len = math.sqrt(dx * dx + dz * dz)
		local ux, uz = dx / len, dz / len
		for j = 1, math.floor(len / 36) do
			for _, side in ipairs({ -1, 1 }) do
				local x = s.ax + ux * j * 36 - uz * (s.w / 2 + 16) * side
				local z = s.az + uz * j * 36 + ux * (s.w / 2 + 16) * side
				if not blocked(x, z, 6, true) then
					if j % 2 == 0 then
						createTree(parent, V(x, groundY(x, z), z), 1)
					else
						createBush(parent, V(x, groundY(x, z), z), 1.3)
					end
				end
			end
		end
	end
	-- colinas
	for _, h in ipairs(hills) do
		createTree(parent, h.pos + V(rng:NextNumber(-8, 8), h.h, rng:NextNumber(-8, 8)), 1.2)
		createTree(parent, h.pos + V(rng:NextNumber(-12, 12), h.h, rng:NextNumber(-12, 12)), 0.9)
		createBush(parent, h.pos + V(rng:NextNumber(-12, 12), h.h, rng:NextNumber(-12, 12)), 1.4)
	end
	-- base das montanhas
	for _, m in ipairs(innerMountains) do
		local rad = m.pos.Unit
		local tan = V(-rad.Z, 0, rad.X)
		for i = 1, 5 do
			local p = m.pos - rad * (m.w * 0.55 + rng:NextNumber(10, 50)) + tan * rng:NextNumber(-m.w * 0.4, m.w * 0.4)
			if not blocked(p.X, p.Z, 6) then
				if i % 2 == 0 then
					createBush(parent, V(p.X, 0, p.Z), 1.6)
				else
					createTree(parent, V(p.X, 0, p.Z), 1.3)
				end
			end
		end
	end
	-- campo aberto
	for _ = 1, 70 do
		local a = rng:NextNumber(0, 2 * PI)
		local r = rng:NextNumber(350, 560)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if not blocked(x, z, 8) then
			createTree(parent, V(x, groundY(x, z), z), rng:NextNumber(0.9, 1.4))
		end
	end
	-- arbustos e plantas pela cidade
	for _ = 1, 60 do
		local a = rng:NextNumber(0, 2 * PI)
		local r = rng:NextNumber(100, 400)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if not blocked(x, z, 4) then
			createBush(parent, V(x, groundY(x, z), z), rng:NextNumber(0.9, 1.5))
		end
	end
end

