local function createStreetLight(parent, base, toward)
	local cf = CFrame.lookAt(base, V(toward.X, base.Y, toward.Z))
	cyl(parent, 13, 0.8, cf * CFrame.new(0, 6.9, 0), C.DarkMetal, Enum.Material.Metal, { Name = "Poste" })
	make(parent, V(0.6, 0.6, 5), cf * CFrame.new(0, 13.2, -2.2), C.DarkMetal, Enum.Material.Metal,
		{ CanCollide = false, Name = "Braco" })
	local bulb = ball(parent, V(1.8, 1.2, 1.8), cf * CFrame.new(0, 12.8, -4.4), C.Warm, Enum.Material.Neon,
		{ CanCollide = false, Name = "Lampada" })
	if streetLightCount < 22 then
		streetLightCount = streetLightCount + 1
		addLight(bulb, C.Warm, 28, 1.2, true)
	end
end

local function createRoad(parent, a, b, width, opts)
	opts = opts or {}
	local dir = (b - a).Unit
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b)
	make(parent, V(width, 0.4, len), cf * CFrame.new(0, 0.3, 0), C.Road, Enum.Material.Asphalt, { Name = "Estrada" })
	make(parent, V(0.5, 0.1, len * 0.97), cf * CFrame.new(0, 0.52, 0), C.Line, Enum.Material.Neon,
		{ CanCollide = false, Name = "Faixa" })
	for _, s in ipairs({ -1, 1 }) do
		make(parent, V(5, 0.8, len), cf * CFrame.new(s * (width / 2 + 2.5), 0.3, 0), C.Sidewalk,
			Enum.Material.Concrete, { Name = "Calcada" })
	end
	roadSegs[#roadSegs + 1] = {
		ax = a.X, az = a.Z, bx = b.X, bz = b.Z, w = width + 10, trees = opts.Trees, width = width,
	}
	if opts.Lights then
		local perp = V(-dir.Z, 0, dir.X)
		local n = math.max(1, math.floor(len / (opts.Spacing or 80)))
		local sides = { -1, 1 }
		if opts.Both == false then
			sides = { 1 }
		end
		for i = 1, n do
			local pt = a + dir * (len * (i - 0.5) / n)
			for _, s in ipairs(sides) do
				local base = pt + perp * s * (width / 2 + 3)
				createStreetLight(opts.Lights, base, base - perp * s * 10)
			end
		end
	end
end

local function createBridge(parent, a, b, width, record)
	local mid, len = (a + b) / 2, (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	make(parent, V(width, 0.6, len + 4), cf * CFrame.new(0, 0.7, 0), C.DarkMetal, Enum.Material.Metal, { Name = "Tabuleiro" })
	make(parent, V(0.5, 0.1, len + 2), cf * CFrame.new(0, 1.05, 0), C.Line, Enum.Material.Neon,
		{ CanCollide = false, Name = "FaixaPonte" })
	local ph = width > 12 and 16 or 7
	for _, s in ipairs({ -1, 1 }) do
		make(parent, V(1, 3, len + 4), cf * CFrame.new(s * (width / 2 - 0.5), 2.4, 0), C.DarkMetal,
			Enum.Material.Metal, { Name = "Guarda" })
		make(parent, V(0.4, 0.4, len + 4), cf * CFrame.new(s * (width / 2 - 0.5), 4.1, 0), C.Vib,
			Enum.Material.Neon, { CanCollide = false, Name = "NeonGuarda" })
		for _, e in ipairs({ -1, 1 }) do
			cyl(parent, ph, 2.4, cf * CFrame.new(s * (width / 2 + 1), ph / 2, e * (len / 2 + 2)), C.Metal,
				Enum.Material.Metal, { Name = "Pilar" })
			ball(parent, V(3, 3, 3), cf * CFrame.new(s * (width / 2 + 1), ph + 1, e * (len / 2 + 2)), C.Vib,
				Enum.Material.Neon, { CanCollide = false, Name = "LuzPilar" })
		end
	end
	if width > 12 then
		for _, e in ipairs({ -1, 1 }) do
			make(parent, V(width + 4, 1.6, 1.6), cf * CFrame.new(0, ph + 0.5, e * (len / 2 + 2)), C.Vib,
				Enum.Material.Neon, { CanCollide = false, Name = "Portico" })
		end
	end
	if record ~= false then
		roadSegs[#roadSegs + 1] = { ax = a.X, az = a.Z, bx = b.X, bz = b.Z, w = width + 10 }
	end
end

