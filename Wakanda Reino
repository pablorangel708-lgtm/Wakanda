local function createBattlefield(F)
	local g = F.Campo

	-- grande planicie de savana
	cyl(g, 0.4, FIELD_R * 2, BC + V(0, 0.2, 0), Color3.fromRGB(96, 136, 60), Enum.Material.Grass, { Name = "CampoGrama" })
	local tones = {
		Color3.fromRGB(122, 150, 66), Color3.fromRGB(82, 120, 56),
		Color3.fromRGB(140, 152, 74), Color3.fromRGB(108, 128, 58),
	}
	for i = 1, 16 do
		local a = rng:NextNumber(0, 2 * PI)
		local r = FIELD_R * math.sqrt(rng:NextNumber(0.05, 0.85))
		cyl(g, 0.1, rng:NextNumber(110, 230), BC + V(math.cos(a) * r, 0.42 + i * 0.012, math.sin(a) * r),
			tones[(i % #tones) + 1], Enum.Material.Grass, { CanCollide = false, Name = "Mancha" })
	end

	-- area central ampla de combate
	cyl(g, 0.2, 340, BC + V(0, 0.55, 0), Color3.fromRGB(150, 118, 84), Enum.Material.Ground, { Name = "ArenaTerra" })
	cyl(g, 0.2, 250, BC + V(0, 0.65, 0), Color3.fromRGB(132, 104, 76), Enum.Material.Ground, { Name = "ArenaTerra2" })
	cyl(g, 0.2, 90, BC + V(0, 0.8, 0), C.Stone, Enum.Material.Slate, { Name = "PlataformaCentral" })
	local map = make(g, V(60, 1, 60), BC + V(0, 1.2, 0), C.DarkMetal, Enum.Material.Metal, { Name = "MapaMundiCentral" })
	addMap(map, Enum.NormalId.Top)
	make(g, V(62, 0.3, 62), BC + V(0, 1.75, 0), C.Vib, Enum.Material.Neon, { CanCollide = false, Name = "BordaMapa" })
	for k = 0, 3 do
		local a = k * PI / 2 + PI / 4
		createStele(g, BC + V(math.cos(a) * 62, 0.9, math.sin(a) * 62), 12, 14, -a + PI / 2)
	end
	for i = 1, 14 do
		local a = rng:NextNumber(0, 2 * PI)
		local r = rng:NextNumber(70, FIELD_R * 0.9)
		createCrater(g, BC + V(math.cos(a) * r, 0, math.sin(a) * r), rng:NextNumber(12, 30), r < 170 and 0.9 or 0.5)
	end

	-- pontos aleatorios fora da arena e fora da estrada
	local function samplePoint(rMin, rMax, y)
		for _ = 1, 12 do
			local a = rng:NextNumber(0, 2 * PI)
			local r = math.sqrt(rng:NextNumber(rMin * rMin, rMax * rMax))
			local x, z = math.cos(a) * r, math.sin(a) * r
			if not (math.abs(x) < 40 and z > 100) then
				return V(BC.X + x, y, BC.Z + z)
			end
		end
		return nil
	end

	-- vegetacao espalhada
	for i = 1, 70 do
		local p = samplePoint(190, FIELD_R - 20, 0.4)
		if p then
			createTree(g, p, rng:NextNumber(1.3, 2.2), (i % 3 == 0) and 3 or 1)
		end
	end
	for _ = 1, 50 do
		local p = samplePoint(120, FIELD_R - 10, 0.4)
		if p then
			createBush(g, p, rng:NextNumber(1.4, 2.4))
		end
	end

	-- rochas e obstaculos naturais
	for _ = 1, 46 do
		local p = samplePoint(110, FIELD_R - 15, 0.4)
		if p then
			createRockCluster(g, p, rng:NextNumber(5, 13))
		end
	end
	for i = 1, 14 do
		local a = i / 14 * 2 * PI + rng:NextNumber(-0.15, 0.15)
		local r = FIELD_R + rng:NextNumber(-60, 20)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if not (math.abs(x) < 70 and z > 0) then
			createRockSpire(g, V(BC.X + x, 0.4, BC.Z + z), rng:NextNumber(40, 85), rng:NextNumber(22, 36))
		end
	end

	-- estruturas de Wakanda perto do campo
	createGate(g, -1000)
	for k = 0, 5 do
		local a = PI * 0.12 + k * PI * 0.152 -- arco voltado para a cidade
		createWatchtower(g, BC + V(math.cos(a) * (FIELD_R - 30), 0.4, math.sin(a) * (FIELD_R - 30)))
	end
	for _, s in ipairs({ -1, 1 }) do
		local labPos = V(s * 400, 0.4, -1200)
		withScale(1.6, labPos, function()
			createLab(g, Vector3.zero, (BC - labPos), 44, 28, s < 0 and C.Cyan or C.Vib, "POSTO DE COMANDO")
		end)
		createVehicle(g, V(s * 230, 5, -1170), s * 0.5, C.Vib)
		createVehicle(g, V(s * 300, 5, -1790), s * -0.4, C.Cyan)
		createEnergyTower(g, V(s * 300, 0.4, -1330), 96, C.Cyan)
		createEnergyTower(g, V(s * 440, 0.4, -1520), 110, C.Vib)
	end

	-- horizonte: torres e predios de Wakanda ao fundo
	for i = 0, 6 do
		local x = -600 + i * 200 + rng:NextNumber(-25, 25)
		createBuilding(g, V(x, 0.3, -2000 + rng:NextNumber(-30, 30)), 46, 46, rng:NextNumber(230, 360),
			(i % 2 == 0) and "spire" or "dome")
	end
	for _, s in ipairs({ -1, 1 }) do
		withScale(3, V(s * 340, 0.3, -1960), function()
			createEnergyTower(g, Vector3.zero, 90, C.Vib)
		end)
	end
	reserve(BC.X, BC.Z, FIELD_R + 40)
end

