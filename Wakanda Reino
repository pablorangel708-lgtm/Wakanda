------------------------------------------------------------------
local function createVegetation(parent)
	-- arvores nas avenidas
	for _, s in ipairs(roadSegs) do
		if s.trees then
			local dx, dz = s.bx - s.ax, s.bz - s.az
			local len = math.sqrt(dx * dx + dz * dz)
			local ux, uz = dx / len, dz / len
			local px, pz = -uz, ux
			for i = 1, math.floor(len / 45) do
				for _, side in ipairs({ -1, 1 }) do
					local off = s.width / 2 + 14
					local x = s.ax + ux * i * 45 + px * off * side
					local z = s.az + uz * i * 45 + pz * off * side
					if not blocked(x, z, 4) then
						createTree(parent, V(x, groundY(x, z), z), 1.1)
					end
				end
			end
		end
	end
	-- margens do rio
	for _, s in ipairs(riverSegs) do
		local dx, dz = s.bx - s.ax, s.bz - s.az
		local len = math.sqrt(dx * dx + dz * dz)
		local ux, uz = dx / len, dz / len
		for j = 1, math.floor(len / 40) do
			for _, side in ipairs({ -1, 1 }) do
				local x = s.ax + ux * j * 40 - uz * (s.w / 2 + 16) * side
				local z = s.az + uz * j * 40 + ux * (s.w / 2 + 16) * side
				if not blocked(x, z, 6, true) then
					if j % 2 == 0 then
						createTree(parent, V(x, groundY(x, z), z), 1.2)
					else
						createBush(parent, V(x, groundY(x, z), z), 1.5)
					end
				end
			end
		end
	end
	-- colinas
	for _, h in ipairs(hills) do
		createTree(parent, h.pos + V(rng:NextNumber(-8, 8), h.h, rng:NextNumber(-8, 8)), 1.4)
		createTree(parent, h.pos + V(rng:NextNumber(-12, 12), h.h, rng:NextNumber(-12, 12)), 1.1)
		createBush(parent, h.pos + V(rng:NextNumber(-12, 12), h.h, rng:NextNumber(-12, 12)), 1.6)
	end
	-- base das montanhas internas
	for _, m in ipairs(innerMountains) do
		local rad = m.pos.Unit
		local tan = V(-rad.Z, 0, rad.X)
		for i = 1, 6 do
			local p = m.pos - rad * (m.w * 0.55 + rng:NextNumber(10, 60)) + tan * rng:NextNumber(-m.w * 0.4, m.w * 0.4)
			if not blocked(p.X, p.Z, 6) then
				if i % 2 == 0 then
					createBush(parent, V(p.X, 0, p.Z), 1.8)
				else
					createTree(parent, V(p.X, 0, p.Z), 1.5)
				end
			end
		end
	end
	-- campo aberto
	for _ = 1, 90 do
		local a = rng:NextNumber(0, 2 * PI)
		local r = rng:NextNumber(620, 1100)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if z > -900 and not blocked(x, z, 8) then
			createTree(parent, V(x, 0, z), rng:NextNumber(1.1, 1.7))
		end
	end
	-- arbustos pela cidade
	for _ = 1, 70 do
		local a = rng:NextNumber(0, 2 * PI)
		local r = rng:NextNumber(260, 600)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if not blocked(x, z, 6) then
			createBush(parent, V(x, groundY(x, z), z), rng:NextNumber(1.2, 2))
		end
	end
end

