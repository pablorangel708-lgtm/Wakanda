local function createRoundabout(parent, pos, r)
	cyl(parent, 0.4, r * 2, pos + V(0, 0.3, 0), C.Road, Enum.Material.Asphalt, { Name = "Rotatoria" })
	cyl(parent, 0.9, r * 1.2, pos + V(0, 0.55, 0), C.Ground, Enum.Material.Grass, { Name = "IlhaRotatoria" })
