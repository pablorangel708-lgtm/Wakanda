local function createCity(parent)
	local bands = {
		{ r = 300, sp = 100, kind = "sky", w = { 40, 56 }, h = { 220, 330 } },
		{ r = 365, sp = 100, kind = "sky", w = { 38, 52 }, h = { 170, 270 } },
		{ r = 430, sp = 90, kind = "mid", w = { 32, 44 }, h = { 110, 200 } },
		{ r = 495, sp = 80, kind = "mid", w = { 28, 38 }, h = { 70, 140 } },
		{ r = 555, sp = 72, kind = "house", w = { 24, 30 }, h = { 40, 80 } },
	}
	local styles = { "spire", "dome", "plain" }
	for bi, band in ipairs(bands) do
		local n = math.floor(2 * PI * band.r / band.sp)
		for i = 0, n - 1 do
			local ang = (i / n) * 2 * PI + bi * 0.23 + rng:NextNumber(-0.02, 0.02)
			local x = math.cos(ang) * band.r + rng:NextNumber(-5, 5)
			local z = math.sin(ang) * band.r + rng:NextNumber(-5, 5)
			if not blocked(x, z, 26) then
				local roll = rng:NextNumber()
				local houseChance = (band.kind == "sky" and 0) or (band.kind == "mid" and 0.3) or 0.7
				if roll < houseChance then
					local s = 1.8
					withScale(s, nil, function()
						createHouse(parent, V(x / s, 0.3 / s, z / s), rng:NextNumber(10, 13))
					end)
					reserve(x, z, 24)
				else
					local w = rng:NextNumber(band.w[1], band.w[2])
					local d = rng:NextNumber(band.w[1], band.w[2])
					local style = band.kind == "sky" and styles[rng:NextInteger(1, 3)] or "plain"
					createBuilding(parent, V(x, 0.3, z), w, d, rng:NextNumber(band.h[1], band.h[2]), style)
					reserve(x, z, math.max(w, d) * 0.9)
				end
			end
		end
	end
end

