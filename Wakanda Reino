local FIELD_R = 520

local function createRockCluster(parent, pos, s)
	local col = ROCKS[rng:NextInteger(1, #ROCKS)]
	for i = 1, rng:NextInteger(2, 3) do
		local sz = V(s * rng:NextNumber(0.9, 1.5), s * rng:NextNumber(0.7, 1.6), s * rng:NextNumber(0.9, 1.5))
		local cf = CFrame.new(pos + V(rng:NextNumber(-1, 1) * s * 0.8, sz.Y * 0.35, rng:NextNumber(-1, 1) * s * 0.8))
			* CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, PI), rng:NextNumber(-0.3, 0.3))
		make(parent, sz, cf, col:Lerp(C.Stone, rng:NextNumber(0, 0.4)), Enum.Material.Rock,
			{ Name = "Rocha", Shadow = s > 8 })
	end
end

local function createRockSpire(parent, pos, h, w)
	local col = ROCKS[rng:NextInteger(1, #ROCKS)]
	local yaw = rng:NextNumber(0, PI)
	for i = 1, 3 do
		local f = (i - 1) / 3
		local sw = w * (1 - f * 0.55)
		local sh = h / 3
		local cf = CFrame.new(pos + V(rng:NextNumber(-2, 2), sh * (i - 0.5), rng:NextNumber(-2, 2)))
			* CFrame.Angles(rng:NextNumber(-0.08, 0.08), yaw + i * 0.4, rng:NextNumber(-0.08, 0.08))
		make(parent, V(sw, sh + 2, sw * 0.8), cf, col:Lerp(Color3.fromRGB(150, 140, 128), f * 0.5),
			Enum.Material.Rock, { Name = "Formacao", Shadow = true })
	end
end

